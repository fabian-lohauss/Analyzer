@page
@model IndexModel
@{
    ViewData["Title"] = "Competition analysis";
}

<section class="query-toolbar">
    <div class="query-title">
        <p class="eyebrow">WDSF official results</p>
        <h1>Competition analysis</h1>
    </div>
    <form method="post" class="min-form" data-analysis-form>
        <div class="input-row">
            <label asp-for="Min">Partner MIN<input asp-for="Min" inputmode="numeric" autocomplete="off" placeholder="10006615" /></label>
            <label asp-for="CoverageStart">Coverage from<input asp-for="CoverageStart" type="month" max="@Model.MaximumCoverageMonth" /></label>
            <button type="submit">Analyze</button>
        </div>
        <span asp-validation-for="Min" class="field-error"></span>
        <span asp-validation-for="CoverageStart" class="field-error"></span>
    </form>
</section>

@if (Model.LoadError is not null)
{
    <div class="notice notice-error" role="alert"><strong>Analysis could not be loaded.</strong><span>@Model.LoadError</span></div>
}

@if (Model.Analysis is null)
{
    <section class="empty-state">
        <p>Enter either partner's MIN to analyze completed competitions from the selected month onward.</p>
    </section>
}
else
{
    var analysis = Model.Analysis;
    var judges = analysis.Judges ?? [];
    var analyzedCompetitions = analysis.Competitions
        .Where(competition => judges.Any(judge => judge.CompetitionValues.ContainsKey(competition.Id)))
        .OrderByDescending(competition => competition.Date)
        .ToList();
    <section class="identity-strip">
        <div>
            <h2>@analysis.Athlete.Name <span>+</span> @(analysis.Partnership?.PartnerName ?? "Partner unavailable")</h2>
            <p>@analysis.Competitions.Count completed competitions · since @analysis.CoverageStart.ToString("MMM yyyy") · @analysis.Athlete.Country · @analysis.Athlete.AgeGroup</p>
        </div>
        <div class="identity-actions">
            <a href="@analysis.Athlete.ProfileUrl" target="_blank" rel="noopener">WDSF profile ↗</a>
            <form method="post" data-analysis-form>
                <input type="hidden" asp-for="Min" />
                <input type="hidden" asp-for="CoverageStart" />
                <button type="submit" name="refresh" value="true" class="secondary-button">Refresh source</button>
            </form>
        </div>
    </section>

    <section class="data-section judge-section">
        <div class="section-heading">
            <div><p class="eyebrow">All supported rounds</p><h2>Judge matrix</h2></div>
            <p>P = preliminary · F = final · Δ = final-place deviation</p>
        </div>
        @if (judges.Count == 0)
        {
            <div class="notice">No supported preliminary marks were found on the published Results pages.</div>
        }
        else
        {
            <div class="matrix-filter" data-matrix-filter hidden>
                <div data-judge-filter-status hidden>
                    <span>Adjudicator: <strong data-judge-filter-label></strong></span>
                    <button type="button" class="secondary-button" data-judge-filter-clear>Clear adjudicator</button>
                </div>
                <div data-competition-filter-status hidden>
                    <span data-competition-filter-label></span>
                    <button type="button" class="secondary-button" data-competition-filter-clear>Clear competition</button>
                </div>
            </div>
            <div class="table-shell matrix-shell">
                <table class="judge-matrix">
                    <thead><tr><th class="adjudicator-heading">
                        <button type="button" class="column-sort-button" data-matrix-sort="name" aria-pressed="false">Adjudicator <span aria-hidden="true">↑</span></button>
                        <input type="search" data-judge-search aria-label="Filter adjudicators by name" placeholder="Filter name" autocomplete="off" />
                    </th>
                    <th><button type="button" class="column-sort-button" data-matrix-sort="overall" aria-pressed="true"><span data-summary-heading>Overall</span><span aria-hidden="true">↓</span></button></th>
                    <th><button type="button" class="column-sort-button" data-matrix-sort="preliminary" aria-pressed="false">Average P <span aria-hidden="true">↓</span></button></th>
                    <th><button type="button" class="column-sort-button" data-matrix-sort="final" aria-pressed="false">Average F <span aria-hidden="true">↓</span></button></th>
                    <th><button type="button" class="column-sort-button" data-matrix-sort="coverage" aria-pressed="false">Competitions <span aria-hidden="true">↓</span></button></th>
                    @foreach (var competition in analyzedCompetitions)
                    {
                        var city = competition.Location.Split(',')[0].Trim();
                        var filterLabel = $"{city} · {competition.Date:MMM yy} — {competition.Type} {competition.AgeClass} {competition.Discipline}";
                        <th data-competition-id="@competition.Id">
                            <button type="button"
                                    class="competition-filter-button"
                                    data-competition-filter="@competition.Id"
                                    data-filter-label="@filterLabel"
                                    title="Filter to @competition.Type, @competition.Location on @competition.Date.ToString("dd MMM yyyy")"
                                    aria-pressed="false">
                                <span>@city</span><small>@competition.Date.ToString("MMM yy")</small>
                            </button>
                        </th>
                    }
                    </tr></thead>
                    <tbody>
                    @foreach (var judge in judges)
                    {
                        var eligible = judge.CompetitionCount >= 3;
                        var averageP = judge.AveragePreliminarySupport;
                        var averageF = judge.AverageFinalSupport;
                        var averageFDeviation = judge.AverageRelativeFinalDeviation;
                        <tr data-judge-row
                            data-overall="@judge.OverallRanking.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                            data-overall-support="@judge.OverallSupport.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                            data-overall-confidence="@judge.OverallConfidence.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                            data-overall-p="@(averageP?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                            data-overall-f="@(averageF?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                            data-overall-f-deviation="@(averageFDeviation?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                            data-coverage="@judge.CompetitionCount"
                            data-eligible="@eligible.ToString().ToLowerInvariant()">
                            <td><button type="button" class="judge-filter-button" data-judge-filter="@judge.Name" aria-pressed="false"><strong>@judge.Name</strong></button>@if (!eligible) { <small>Limited sample</small> }</td>
                            <td class="support-index" data-summary-cell data-overall-text="@judge.OverallSupport.ToString("0")% · confidence @((judge.OverallConfidence * 100).ToString("0"))%"><span>@judge.OverallSupport.ToString("0")%</span><small>confidence @((judge.OverallConfidence * 100).ToString("0"))%</small></td>
                            <td class="deviation @(eligible && averageP.HasValue ? (averageP > 50 ? "positive" : averageP < 50 ? "negative" : "neutral") : "")">@(averageP.HasValue ? $"P {averageP:0}%" : "—")</td>
                            <td class="deviation @(eligible && averageF.HasValue ? (averageF > 50 ? "positive" : averageF < 50 ? "negative" : "neutral") : "")">@(averageF.HasValue ? $"F {averageF:0}%" : "—")@if (averageFDeviation.HasValue) { <small>Δ @averageFDeviation.Value.ToString("+0.00;-0.00;0.00")</small> }</td>
                            <td>@judge.CompetitionCount <small>@judge.ObservationCount @(judge.ObservationCount == 1 ? "observation" : "observations")</small></td>
                            @foreach (var competition in analyzedCompetitions)
                            {
                                if (judge.CompetitionValues.TryGetValue(competition.Id, out var value))
                                {
                                    var competitionScore = value.FinalSupport ?? value.PreliminarySupport;
                                    var direction = competitionScore - 50;
                                    <td class="deviation @(eligible && competitionScore.HasValue ? (direction > 0 ? "positive" : direction < 0 ? "negative" : "neutral") : "")" data-competition-id="@competition.Id" data-score="@(competitionScore?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")" data-final-support="@(value.FinalSupport?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")" data-preliminary-support="@(value.PreliminarySupport?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")" data-final-deviation="@(value.FinalDeviation?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")">
                                        <button type="button"
                                                class="cell-detail-button"
                                                data-detail-url="@Url.Page("/Index", "CellDetail", new { min = Model.Min, coverageStart = Model.CoverageStart, judgeName = judge.Name, competitionId = competition.Id })"
                                                aria-expanded="false"
                                                aria-label="Show round details for @judge.Name at @competition.Location">
                                            <span class="competition-score-line"><span>F @(value.FinalSupport.HasValue ? $"{value.FinalSupport:0}%" : "—")</span>@if (value.FinalDeviation.HasValue) { <small>Δ @value.FinalDeviation.Value.ToString("+0.00;-0.00;0.00")</small> }</span>
                                            <span class="competition-score-line">P @(value.PreliminarySupport.HasValue ? $"{value.PreliminarySupport:0}%" : "—")</span>
                                        </button>
                                    </td>
                                }
                                else
                                {
                                    <td class="missing" data-competition-id="@competition.Id">—</td>
                                }
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="mobile-matrix" data-mobile-matrix>
                <div class="mobile-matrix-controls">
                    <label class="mobile-competition-control">
                        Competition
                        <select data-mobile-competition-filter>
                            <option value="">All competitions</option>
                            @foreach (var competition in analyzedCompetitions)
                            {
                                var city = competition.Location.Split(',')[0].Trim();
                                <option value="@competition.Id">@city · @competition.Date.ToString("MMM yy") — @competition.Type @competition.AgeClass @competition.Discipline · #@competition.Id</option>
                            }
                        </select>
                    </label>
                    <label>
                        Find adjudicator
                        <input type="search" data-mobile-judge-search placeholder="Filter name" autocomplete="off" />
                    </label>
                    <label>
                        Sort by
                        <select data-mobile-matrix-sort>
                            <option value="overall">Overall support</option>
                            <option value="competition" hidden>Competition value</option>
                            <option value="final">Final</option>
                            <option value="preliminary">Preliminary</option>
                            <option value="coverage">Competitions</option>
                            <option value="name">Adjudicator</option>
                        </select>
                    </label>
                </div>
                <p class="mobile-matrix-empty" data-mobile-matrix-empty hidden>No adjudicators match this name.</p>
                <div class="mobile-judge-list" data-mobile-judge-list>
                @foreach (var judge in judges)
                {
                    var averageP = judge.AveragePreliminarySupport;
                    var averageF = judge.AverageFinalSupport;
                    var averageFDeviation = judge.AverageRelativeFinalDeviation;
                    var judgeCompetitions = analyzedCompetitions
                        .Where(competition => judge.CompetitionValues.ContainsKey(competition.Id))
                        .ToList();
                    <article class="mobile-judge-card"
                             data-mobile-judge-card
                             data-name="@judge.Name"
                             data-overall="@judge.OverallSupport.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                             data-final="@(averageF?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                             data-preliminary="@(averageP?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                             data-coverage="@judge.CompetitionCount">
                        <button type="button" class="mobile-judge-toggle" data-mobile-judge-toggle aria-expanded="false">
                            <span class="mobile-judge-name"><strong>@judge.Name</strong>@if (judge.CompetitionCount < 3) { <small>Limited sample</small> }</span>
                            <span class="mobile-judge-overall"><strong>@judge.OverallSupport.ToString("0")%</strong><small>confidence @((judge.OverallConfidence * 100).ToString("0"))%</small></span>
                            <span class="mobile-judge-chevron" aria-hidden="true">+</span>
                        </button>
                        <dl class="mobile-judge-metrics">
                            <div><dt>Preliminary</dt><dd>@(averageP.HasValue ? $"{averageP:0}%" : "—")</dd></div>
                            <div><dt>Final</dt><dd>@(averageF.HasValue ? $"{averageF:0}%" : "—")@if (averageFDeviation.HasValue) { <small>Δ @averageFDeviation.Value.ToString("+0.00;-0.00;0.00")</small> }</dd></div>
                            <div><dt>Competitions</dt><dd>@judge.CompetitionCount</dd></div>
                        </dl>
                        <div class="mobile-competition-list" data-mobile-competition-list hidden>
                        @foreach (var competition in judgeCompetitions)
                        {
                            var value = judge.CompetitionValues[competition.Id];
                            var competitionScore = value.FinalSupport ?? value.PreliminarySupport;
                            var direction = competitionScore - 50;
                            var directionClass = judge.CompetitionCount >= 3 && competitionScore.HasValue
                                ? direction > 0 ? "positive" : direction < 0 ? "negative" : "neutral"
                                : "";
                            <button type="button"
                                    class="mobile-competition-button cell-detail-button @directionClass"
                                    data-mobile-competition-id="@competition.Id"
                                    data-score="@(competitionScore?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                    data-score-label="@(value.FinalSupport.HasValue ? $"F {value.FinalSupport:0}%" : value.PreliminarySupport.HasValue ? $"P {value.PreliminarySupport:0}%" : "—")"
                                    data-score-detail="@(value.FinalDeviation.HasValue ? $"Δ {value.FinalDeviation.Value:+0.00;-0.00;0.00}" : competition.Date.ToString("dd MMM yyyy"))"
                                    data-detail-url="@Url.Page("/Index", "CellDetail", new { min = Model.Min, coverageStart = Model.CoverageStart, judgeName = judge.Name, competitionId = competition.Id })"
                                    aria-expanded="false"
                                    aria-label="Show round details for @judge.Name at @competition.Location">
                                <span class="mobile-competition-place"><strong>@competition.Location.Split(',')[0].Trim()</strong><small>@competition.Date.ToString("dd MMM yyyy")</small></span>
                                <span class="mobile-competition-score"><span>F @(value.FinalSupport.HasValue ? $"{value.FinalSupport:0}%" : "—")@if (value.FinalDeviation.HasValue) { <small>Δ @value.FinalDeviation.Value.ToString("+0.00;-0.00;0.00")</small> }</span><span>P @(value.PreliminarySupport.HasValue ? $"{value.PreliminarySupport:0}%" : "—")</span></span>
                                <span class="mobile-competition-arrow" aria-hidden="true">›</span>
                            </button>
                        }
                        </div>
                    </article>
                }
                </div>
            </div>
            <div class="cell-detail-popover" data-cell-detail-popover role="dialog" aria-modal="false" aria-label="Adjudicator round details" hidden>
                <button type="button" class="cell-detail-close" data-cell-detail-close aria-label="Close details">×</button>
                <div data-cell-detail-content></div>
            </div>
        }
    </section>

    <details class="secondary-section">
        <summary><span>Competition history</span><small>@analysis.Competitions.Count competitions · loaded @analysis.LoadedAt.ToLocalTime().ToString("g")</small></summary>
        <div class="secondary-section-content">
        @if (analysis.Competitions.Count == 0)
        {
            <div class="notice">No completed competitions from @analysis.CoverageStart.ToString("MMM yyyy") onward were found.</div>
        }
        else
        {
            <div class="table-shell">
                <table>
                    <thead><tr><th>Date</th><th>Competition</th><th>Discipline</th><th>Result</th><th>Sources</th></tr></thead>
                    <tbody>
                    @foreach (var competition in analysis.Competitions)
                    {
                        <tr>
                            <td data-label="Date"><time datetime="@competition.Date.ToString("yyyy-MM-dd")">@competition.Date.ToString("dd MMM yyyy")</time></td>
                            <td data-label="Competition"><strong>@competition.Type · @competition.AgeClass</strong><small>@competition.Location</small></td>
                            <td data-label="Discipline">@competition.Discipline</td>
                            <td data-label="Result">@(competition.Placement?.ToString() ?? competition.Status)</td>
                            <td class="source-links" data-label="Sources">
                                <a href="@competition.RankingUrl" target="_blank" rel="noopener">Ranking</a>
                                <a href="@competition.ResultsUrl" target="_blank" rel="noopener">Marks</a>
                                <a href="@competition.FinalUrl" target="_blank" rel="noopener">Final</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        </div>
    </details>

    <details class="secondary-section methodology-section">
        <summary><span>Methodology</span><small>How P, F, and Δ are calculated</small></summary>
        <p>P is the percentage of available preliminary marks. F normalizes final rank and adds a 50%-weighted adjustment for Δ, the difference from the achieved dance place.</p>
    </details>
}

<div class="loading-layer" data-loading-layer hidden role="status" aria-live="polite">
    <div class="loading-panel">
        <span class="loading-indicator" aria-hidden="true"></span>
        <strong>Analyzing WDSF results</strong>
        <span>Loading competition pages and calculating judge deviations.</span>
    </div>
</div>
